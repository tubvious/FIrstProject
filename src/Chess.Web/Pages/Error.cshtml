@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-message">
    <img class="page-message__icon" src="~/img/pieces/bK.svg" alt="" />
    <h1>Something went wrong</h1>
    <p>An unexpected error occurred. Please try again in a moment.</p>
    @if (Model.RequestId is not null)
    {
        <p><small>Request ID: <code>@Model.RequestId</code></small></p>
    }
    <a class="btn btn--primary btn--lg" href="/"><icon name="home" />Back to Home</a>
</div>
