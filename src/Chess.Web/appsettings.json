{
  "ConnectionStrings": {
    "Chess": "Data Source=App_Data/chess.db"
  },
  "Chess": {
    "ReconnectGracePeriod": "00:01:00",
    "ClockCheckInterval": "00:00:00.200",
    "IdleGameEvictionAfter": "00:30:00",
    "EvictionSweepInterval": "00:01:00",
    "MaxPlayerNameLength": 24,
    "GameCreationPerMinuteLimit": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
